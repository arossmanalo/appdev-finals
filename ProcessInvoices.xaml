    <Sequence DisplayName="Process Invoices" sap2010:Annotation.AnnotationText="Goes through every invoice row. For each row it checks the data, computes gross, VAT, total billed, due date and balance, decides the status (Paid, Partially Paid, Unpaid, Overdue or Invalid), and writes the results back into the table. It also counts the results for the summary email." sap2010:WorkflowViewState.IdRef="Sequence_1">
        <ui:MultipleAssign DisplayName="Reset Counters and Totals" sap2010:Annotation.AnnotationText="Sets every counter and total to 0 before the loop starts." sap2010:WorkflowViewState.IdRef="MultipleAssign_1">
