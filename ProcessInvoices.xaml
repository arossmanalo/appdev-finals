        <ui:ForEach x:TypeArguments="sd:DataRow" DisplayName="For Each Invoice Row" sap2010:Annotation.AnnotationText="For Each over the billing table rows (TypeArgument System.Data.DataRow). The current invoice is called row, and cells are read with row(&quot;Column Name&quot;).ToString." sap2010:WorkflowViewState.IdRef="ForEach`1_1">
            <ui:ForEach.Values>
                <InArgument x:TypeArguments="sc:IEnumerable">
                    <VisualBasicValue x:TypeArguments="sc:IEnumerable" ExpressionText="io_BillingTable.Rows" />
                </InArgument>
            </ui:ForEach.Values>
            <ui:ForEach.Body>
                <ActivityAction x:TypeArguments="sd:DataRow">
                    <ActivityAction.Argument>
                        <DelegateInArgument x:TypeArguments="sd:DataRow" Name="row" />
                    </ActivityAction.Argument>
                    <Sequence DisplayName="Body" sap2010:WorkflowViewState.IdRef="Sequence_2">
                        <Sequence.Variables>
                            <Variable x:TypeArguments="x:Boolean" Name="IsEmailed" />
                            <Variable x:TypeArguments="x:Boolean" Name="IsValid" />
                            <Variable x:TypeArguments="x:Double" Name="ParcelsValue" />
                            <Variable x:TypeArguments="x:Double" Name="RateValue" />
                            <Variable x:TypeArguments="x:Int32" Name="TermsValue" />
                            <Variable x:TypeArguments="s:DateTime" Name="InvoiceDateValue" />
                            <Variable x:TypeArguments="x:Double" Name="PaidValue" />
                            <Variable x:TypeArguments="x:Double" Name="GrossAmount" />
                            <Variable x:TypeArguments="x:Double" Name="VatAmount" />
                            <Variable x:TypeArguments="x:Double" Name="TotalAmount" />
                            <Variable x:TypeArguments="s:DateTime" Name="DueDateValue" />
                            <Variable x:TypeArguments="x:Double" Name="BalanceAmount" />
                            <Variable x:TypeArguments="x:String" Name="StatusText" />
                            <Variable x:TypeArguments="x:String" Name="EmailAction" />
                            <Variable x:TypeArguments="x:Boolean" Name="EmailSent" />
                        </Sequence.Variables>
                        <Assign DisplayName="Check If Already Emailed" sap2010:Annotation.AnnotationText="A row was emailed before when its Email Status cell is not blank." sap2010:WorkflowViewState.IdRef="Assign_1">
                            <Assign.To>
                                <OutArgument x:TypeArguments="x:Boolean">
                                    <VisualBasicReference x:TypeArguments="x:Boolean" ExpressionText="IsEmailed" />
                                </OutArgument>
                            </Assign.To>
                            <Assign.Value>
                                <InArgument x:TypeArguments="x:Boolean">
                                    <VisualBasicValue x:TypeArguments="x:Boolean" ExpressionText="Not String.IsNullOrWhiteSpace(row(&quot;Email Status&quot;).ToString)" />
                                </InArgument>
                            </Assign.Value>
                        </Assign>
                        <If DisplayName="If Skip Already Emailed Row" sap2010:Annotation.AnnotationText="Business rule: a row that was already emailed is skipped unless the user chose Yes for follow-up reminders." sap2010:WorkflowViewState.IdRef="If_1">
                            <If.Condition>
                                <InArgument x:TypeArguments="x:Boolean">
                                    <VisualBasicValue x:TypeArguments="x:Boolean" ExpressionText="IsEmailed AndAlso Not in_SendFollowUps" />
                                </InArgument>
                            </If.Condition>
                            <If.Then>
                                <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_3">
                                    <Assign DisplayName="Count Skipped Row" sap2010:WorkflowViewState.IdRef="Assign_2">
                                        <Assign.To>
                                            <OutArgument x:TypeArguments="x:Int32">
                                                <VisualBasicReference x:TypeArguments="x:Int32" ExpressionText="out_SkippedCount" />
                                            </OutArgument>
                                        </Assign.To>
                                        <Assign.Value>
                                            <InArgument x:TypeArguments="x:Int32">
                                                <VisualBasicValue x:TypeArguments="x:Int32" ExpressionText="out_SkippedCount + 1" />
                                            </InArgument>
                                        </Assign.Value>
                                    </Assign>
                                    <WriteLine DisplayName="Write Skipped Row" sap2010:WorkflowViewState.IdRef="WriteLine_1">
                                        <WriteLine.Text>
                                            <InArgument x:TypeArguments="x:String">
                                                <VisualBasicValue x:TypeArguments="x:String" ExpressionText="row(&quot;Invoice ID&quot;).ToString &amp; &quot;: skipped (already emailed)&quot;" />
                                            </InArgument>
                                        </WriteLine.Text>
                                    </WriteLine>
                                </Sequence>
                            </If.Then>
                            <If.Else>
                                <Sequence DisplayName="Else" sap2010:WorkflowViewState.IdRef="Sequence_4">
                                    <TryCatch DisplayName="Try Process Row" sap2010:Annotation.AnnotationText="If anything unexpected goes wrong with one row (for example text where a number should be), that row is marked Invalid and the run continues with the next row." sap2010:WorkflowViewState.IdRef="TryCatch_1">
                                        <TryCatch.Try>
                                            <Sequence DisplayName="Try" sap2010:WorkflowViewState.IdRef="Sequence_5">
                                                <Assign DisplayName="Check Row Data" sap2010:Annotation.AnnotationText="Bad data rule: Parcels and Rate must be numbers and Invoice Date must be a date. IsNumeric and IsDate return False for blank cells." sap2010:WorkflowViewState.IdRef="Assign_3">
                                                    <Assign.To>
                                                        <OutArgument x:TypeArguments="x:Boolean">
                                                            <VisualBasicReference x:TypeArguments="x:Boolean" ExpressionText="IsValid" />
                                                        </OutArgument>
                                                    </Assign.To>
                                                    <Assign.Value>
                                                        <InArgument x:TypeArguments="x:Boolean">
                                                            <VisualBasicValue x:TypeArguments="x:Boolean" ExpressionText="IsNumeric(row(&quot;Parcels&quot;).ToString) AndAlso IsNumeric(row(&quot;Rate&quot;).ToString) AndAlso IsDate(row(&quot;Invoice Date&quot;).ToString)" />
                                                        </InArgument>
                                                    </Assign.Value>
                                                </Assign>
                                                <If DisplayName="If Row Data Is Bad" sap2010:WorkflowViewState.IdRef="If_2">
                                                    <If.Condition>
                                                        <InArgument x:TypeArguments="x:Boolean">
                                                            <VisualBasicValue x:TypeArguments="x:Boolean" ExpressionText="Not IsValid" />
                                                        </InArgument>
                                                    </If.Condition>
                                                    <If.Then>
                                                        <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_6">
                                                            <ui:MultipleAssign DisplayName="Mark Row Invalid" sap2010:Annotation.AnnotationText="Writes Invalid in the Status cell and counts the row. No email is sent for it." sap2010:WorkflowViewState.IdRef="MultipleAssign_2">
                                                                <ui:MultipleAssign.AssignOperations>
                                                                    <scg:List x:TypeArguments="ui:AssignOperation" Capacity="4">
                                                                        <ui:AssignOperation>
                                                                            <ui:AssignOperation.To>
                                                                                <OutArgument x:TypeArguments="x:Object">
                                                                                    <VisualBasicReference x:TypeArguments="x:Object" ExpressionText="row(&quot;Status&quot;)" />
                                                                                </OutArgument>
                                                                            </ui:AssignOperation.To>
                                                                            <ui:AssignOperation.Value>
                                                                                <InArgument x:TypeArguments="x:Object">
                                                                                    <VisualBasicValue x:TypeArguments="x:Object" ExpressionText="&quot;Invalid&quot;" />
                                                                                </InArgument>
                                                                            </ui:AssignOperation.Value>
                                                                        </ui:AssignOperation>
                                                                        <ui:AssignOperation>
                                                                            <ui:AssignOperation.To>
                                                                                <OutArgument x:TypeArguments="x:Int32">
                                                                                    <VisualBasicReference x:TypeArguments="x:Int32" ExpressionText="out_InvalidCount" />
                                                                                </OutArgument>
                                                                            </ui:AssignOperation.To>
                                                                            <ui:AssignOperation.Value>
                                                                                <InArgument x:TypeArguments="x:Int32">
                                                                                    <VisualBasicValue x:TypeArguments="x:Int32" ExpressionText="out_InvalidCount + 1" />
                                                                                </InArgument>
                                                                            </ui:AssignOperation.Value>
                                                                        </ui:AssignOperation>
                                                                    </scg:List>
                                                                </ui:MultipleAssign.AssignOperations>
                                                            </ui:MultipleAssign>
                                                            <WriteLine DisplayName="Write Invalid Row" sap2010:WorkflowViewState.IdRef="WriteLine_2">
                                                                <WriteLine.Text>
                                                                    <InArgument x:TypeArguments="x:String">
                                                                        <VisualBasicValue x:TypeArguments="x:String" ExpressionText="row(&quot;Invoice ID&quot;).ToString &amp; &quot;: Invalid (bad Parcels, Rate or Invoice Date)&quot;" />
                                                                    </InArgument>
                                                                </WriteLine.Text>
                                                            </WriteLine>
                                                        </Sequence>
                                                    </If.Then>
                                                    <If.Else>
                                                        <Sequence DisplayName="Else" sap2010:WorkflowViewState.IdRef="Sequence_7">
                                                            <ui:MultipleAssign DisplayName="Read Row Values" sap2010:Annotation.AnnotationText="Converts the cell text into numbers and a date with CDbl, CInt and CDate. A blank Amount Paid is treated as 0 (this applies only to Amount Paid)." sap2010:WorkflowViewState.IdRef="MultipleAssign_3">
                                                                <ui:MultipleAssign.AssignOperations>
                                                                    <scg:List x:TypeArguments="ui:AssignOperation" Capacity="8">
                                                                        <ui:AssignOperation>
                                                                            <ui:AssignOperation.To>
                                                                                <OutArgument x:TypeArguments="x:Double">
                                                                                    <VisualBasicReference x:TypeArguments="x:Double" ExpressionText="ParcelsValue" />
                                                                                </OutArgument>
                                                                            </ui:AssignOperation.To>
                                                                            <ui:AssignOperation.Value>
                                                                                <InArgument x:TypeArguments="x:Double">
                                                                                    <VisualBasicValue x:TypeArguments="x:Double" ExpressionText="CDbl(row(&quot;Parcels&quot;).ToString)" />
                                                                                </InArgument>
                                                                            </ui:AssignOperation.Value>
                                                                        </ui:AssignOperation>
                                                                        <ui:AssignOperation>
                                                                            <ui:AssignOperation.To>
                                                                                <OutArgument x:TypeArguments="x:Double">
                                                                                    <VisualBasicReference x:TypeArguments="x:Double" ExpressionText="RateValue" />
                                                                                </OutArgument>
                                                                            </ui:AssignOperation.To>
                                                                            <ui:AssignOperation.Value>
                                                                                <InArgument x:TypeArguments="x:Double">
                                                                                    <VisualBasicValue x:TypeArguments="x:Double" ExpressionText="CDbl(row(&quot;Rate&quot;).ToString)" />
                                                                                </InArgument>
                                                                            </ui:AssignOperation.Value>
                                                                        </ui:AssignOperation>
                                                                        <ui:AssignOperation>
                                                                            <ui:AssignOperation.To>
                                                                                <OutArgument x:TypeArguments="x:Int32">
                                                                                    <VisualBasicReference x:TypeArguments="x:Int32" ExpressionText="TermsValue" />
                                                                                </OutArgument>
                                                                            </ui:AssignOperation.To>
                                                                            <ui:AssignOperation.Value>
                                                                                <InArgument x:TypeArguments="x:Int32">
                                                                                    <VisualBasicValue x:TypeArguments="x:Int32" ExpressionText="CInt(row(&quot;Payment Terms (Days)&quot;).ToString)" />
                                                                                </InArgument>
                                                                            </ui:AssignOperation.Value>
                                                                        </ui:AssignOperation>
                                                                        <ui:AssignOperation>
                                                                            <ui:AssignOperation.To>
                                                                                <OutArgument x:TypeArguments="s:DateTime">
                                                                                    <VisualBasicReference x:TypeArguments="s:DateTime" ExpressionText="InvoiceDateValue" />
                                                                                </OutArgument>
                                                                            </ui:AssignOperation.To>
                                                                            <ui:AssignOperation.Value>
                                                                                <InArgument x:TypeArguments="s:DateTime">
                                                                                    <VisualBasicValue x:TypeArguments="s:DateTime" ExpressionText="CDate(row(&quot;Invoice Date&quot;).ToString)" />
                                                                                </InArgument>
                                                                            </ui:AssignOperation.Value>
                                                                        </ui:AssignOperation>
                                                                        <ui:AssignOperation>
                                                                            <ui:AssignOperation.To>
                                                                                <OutArgument x:TypeArguments="x:Double">
                                                                                    <VisualBasicReference x:TypeArguments="x:Double" ExpressionText="PaidValue" />
                                                                                </OutArgument>
                                                                            </ui:AssignOperation.To>
                                                                            <ui:AssignOperation.Value>
                                                                                <InArgument x:TypeArguments="x:Double">
                                                                                    <VisualBasicValue x:TypeArguments="x:Double" ExpressionText="If(String.IsNullOrWhiteSpace(row(&quot;Amount Paid&quot;).ToString), 0.0, CDbl(row(&quot;Amount Paid&quot;).ToString))" />
                                                                                </InArgument>
                                                                            </ui:AssignOperation.Value>
                                                                        </ui:AssignOperation>
                                                                    </scg:List>
                                                                </ui:MultipleAssign.AssignOperations>
                                                            </ui:MultipleAssign>
                                                            <ui:MultipleAssign DisplayName="Compute Billing Amounts" sap2010:Annotation.AnnotationText="gross = parcels x rate. VAT = 12% of gross. total billed = gross + VAT. due date = invoice date + payment terms. balance = total billed - amount paid. Money is rounded to 2 decimals with Math.Round." sap2010:WorkflowViewState.IdRef="MultipleAssign_4">
                                                                <ui:MultipleAssign.AssignOperations>
                                                                    <scg:List x:TypeArguments="ui:AssignOperation" Capacity="8">
                                                                        <ui:AssignOperation>
                                                                            <ui:AssignOperation.To>
                                                                                <OutArgument x:TypeArguments="x:Double">
                                                                                    <VisualBasicReference x:TypeArguments="x:Double" ExpressionText="GrossAmount" />
                                                                                </OutArgument>
                                                                            </ui:AssignOperation.To>
                                                                            <ui:AssignOperation.Value>
                                                                                <InArgument x:TypeArguments="x:Double">
                                                                                    <VisualBasicValue x:TypeArguments="x:Double" ExpressionText="Math.Round(ParcelsValue * RateValue, 2)" />
                                                                                </InArgument>
                                                                            </ui:AssignOperation.Value>
                                                                        </ui:AssignOperation>
                                                                        <ui:AssignOperation>
                                                                            <ui:AssignOperation.To>
                                                                                <OutArgument x:TypeArguments="x:Double">
                                                                                    <VisualBasicReference x:TypeArguments="x:Double" ExpressionText="VatAmount" />
                                                                                </OutArgument>
                                                                            </ui:AssignOperation.To>
                                                                            <ui:AssignOperation.Value>
                                                                                <InArgument x:TypeArguments="x:Double">
                                                                                    <VisualBasicValue x:TypeArguments="x:Double" ExpressionText="Math.Round(GrossAmount * 0.12, 2)" />
                                                                                </InArgument>
                                                                            </ui:AssignOperation.Value>
                                                                        </ui:AssignOperation>
                                                                        <ui:AssignOperation>
                                                                            <ui:AssignOperation.To>
