  <Sequence sap2010:Annotation.AnnotationText="Sends one email for one invoice. It finds the client's email address in the contacts table, builds the subject and body for the email type (billing statement, overdue reminder or follow-up reminder), and sends it with Gmail SMTP. out_EmailSent tells the caller whether it worked." DisplayName="Send Client Email" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:String" Name="ToEmail" />
      <Variable x:TypeArguments="x:String" Name="ContactName" />
      <Variable x:TypeArguments="x:String" Name="ClientName" />
      <Variable x:TypeArguments="x:String" Name="EmailSubject" />
      <Variable x:TypeArguments="x:String" Name="EmailBody" />
      <Variable x:TypeArguments="x:String" Name="BodyDetails" />
      <Variable x:TypeArguments="x:String" Name="BodyClosing" />
      <Variable x:TypeArguments="x:Int32" Name="DaysOverdue" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:MultipleAssign sap2010:Annotation.AnnotationText="Starts with no email sent and empty client details." DisplayName="Reset Email Values" sap2010:WorkflowViewState.IdRef="MultipleAssign_1">
      <ui:MultipleAssign.AssignOperations>
        <scg:List x:TypeArguments="ui:AssignOperation" Capacity="4">
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_1">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:Boolean">[out_EmailSent]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:Boolean">[False]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_2">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:String">[ToEmail]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:String">[String.Empty]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
        </scg:List>
      </ui:MultipleAssign.AssignOperations>
    </ui:MultipleAssign>
    <ui:ForEach x:TypeArguments="sd:DataRow" CurrentIndex="{x:Null}" sap2010:Annotation.AnnotationText="Looks through the contacts table for the row whose Client ID matches this invoice's client." DisplayName="For Each Contact Row" sap2010:WorkflowViewState.IdRef="ForEach`1_1" Values="[in_ContactsTable.Rows]">
      <ui:ForEach.Body>
        <ActivityAction x:TypeArguments="sd:DataRow">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="sd:DataRow" Name="contactRow" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Body" sap2010:WorkflowViewState.IdRef="Sequence_2">
            <If Condition="[contactRow(&quot;Client ID&quot;).ToString = in_ClientId]" DisplayName="If Client ID Matches" sap2010:WorkflowViewState.IdRef="If_1">
              <If.Then>
                <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_3">
                  <ui:MultipleAssign sap2010:Annotation.AnnotationText="Keeps the matching client's email address, contact person and company name." DisplayName="Save Client Details" sap2010:WorkflowViewState.IdRef="MultipleAssign_2">
                    <ui:MultipleAssign.AssignOperations>
                      <scg:List x:TypeArguments="ui:AssignOperation" Capacity="4">
                        <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_3">
                          <ui:AssignOperation.To>
                            <OutArgument x:TypeArguments="x:String">[ToEmail]</OutArgument>
                          </ui:AssignOperation.To>
                          <ui:AssignOperation.Value>
                            <InArgument x:TypeArguments="x:String">[contactRow("Email").ToString]</InArgument>
                          </ui:AssignOperation.Value>
                        </ui:AssignOperation>
                        <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_4">
                          <ui:AssignOperation.To>
                            <OutArgument x:TypeArguments="x:String">[ContactName]</OutArgument>
                          </ui:AssignOperation.To>
                          <ui:AssignOperation.Value>
                            <InArgument x:TypeArguments="x:String">[contactRow("Contact Person").ToString]</InArgument>
                          </ui:AssignOperation.Value>
                        </ui:AssignOperation>
                        <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_5">
                          <ui:AssignOperation.To>
                            <OutArgument x:TypeArguments="x:String">[ClientName]</OutArgument>
                          </ui:AssignOperation.To>
                          <ui:AssignOperation.Value>
                            <InArgument x:TypeArguments="x:String">[contactRow("Client Name").ToString]</InArgument>
                          </ui:AssignOperation.Value>
                        </ui:AssignOperation>
                      </scg:List>
                    </ui:MultipleAssign.AssignOperations>
                  </ui:MultipleAssign>
                </Sequence>
              </If.Then>
            </If>
          </Sequence>
        </ActivityAction>
      </ui:ForEach.Body>
    </ui:ForEach>
    <If sap2010:Annotation.AnnotationText="Safety check. Company SOP says every client has an email address, but if none is found the email is simply not sent." Condition="[String.IsNullOrWhiteSpace(ToEmail)]" DisplayName="If No Email Address Found" sap2010:WorkflowViewState.IdRef="If_2">
      <If.Then>
        <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_4">
          <WriteLine DisplayName="Write No Email Found" sap2010:WorkflowViewState.IdRef="WriteLine_1" Text="[&quot;No email address found for client &quot; &amp; in_ClientId &amp; &quot; (&quot; &amp; in_InvoiceId &amp; &quot;). Email not sent.&quot;]" />
        </Sequence>
      </If.Then>
      <If.Else>
        <Sequence DisplayName="Else" sap2010:WorkflowViewState.IdRef="Sequence_5">
          <Assign sap2010:Annotation.AnnotationText="Number of days between the due date and the as-of date. Never less than 0." DisplayName="Compute Days Overdue" sap2010:WorkflowViewState.IdRef="Assign_1">
            <Assign.To>
              <OutArgument x:TypeArguments="x:Int32">[DaysOverdue]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:Int32">[Math.Max(0, (in_AsOfDate.Date - in_DueDate.Date).Days)]</InArgument>
            </Assign.Value>
          </Assign>
          <Assign sap2010:Annotation.AnnotationText="The invoice lines shared by all three emails. The amount paid line only appears when a payment was made, so partially paid invoices show both the amount paid and the remaining balance." DisplayName="Build Invoice Details Text" sap2010:WorkflowViewState.IdRef="Assign_2">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">[BodyDetails]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">["Invoice ID: " &amp; in_InvoiceId &amp; vbCrLf &amp; "Total billed (including 12% VAT): PHP " &amp; in_TotalAmount.ToString("N2") &amp; vbCrLf &amp; If(in_PaidAmount &gt; 0, "Amount paid: PHP " &amp; in_PaidAmount.ToString("N2") &amp; vbCrLf, String.Empty) &amp; "Remaining balance: PHP " &amp; in_BalanceAmount.ToString("N2") &amp; vbCrLf &amp; "Due date: " &amp; in_DueDate.ToString("MMMM dd, yyyy")]</InArgument>
            </Assign.Value>
          </Assign>
          <Assign sap2010:Annotation.AnnotationText="The closing shared by all three emails. It pastes in the full Billing Terms and Payment Policy text read from the PDF." DisplayName="Build Closing Text" sap2010:WorkflowViewState.IdRef="Assign_3">
            <Assign.To>
              <OutArgument x:TypeArguments="x:String">[BodyClosing]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="x:String">[vbCrLf &amp; vbCrLf &amp; "----------------------------------------" &amp; vbCrLf &amp; in_PolicyText &amp; vbCrLf &amp; "----------------------------------------" &amp; vbCrLf &amp; vbCrLf &amp; "Thank you," &amp; vbCrLf &amp; "Finance and Accounting" &amp; vbCrLf &amp; "Nerriza Transport Services, Lipa City"]</InArgument>
            </Assign.Value>
          </Assign>
          <Switch x:TypeArguments="x:String" sap2010:Annotation.AnnotationText="Chooses the subject and the opening sentences for the billing statement, the overdue reminder or (default) the follow-up reminder." DisplayName="Switch On Email Type" Expression="[in_EmailType]" sap2010:WorkflowViewState.IdRef="Switch`1_1">
            <Switch.Default>
              <Sequence DisplayName="Follow-up reminder" sap2010:WorkflowViewState.IdRef="Sequence_8">
                <ui:MultipleAssign DisplayName="Build Follow-Up Reminder" sap2010:WorkflowViewState.IdRef="MultipleAssign_5">
                  <ui:MultipleAssign.AssignOperations>
                    <scg:List x:TypeArguments="ui:AssignOperation" Capacity="4">
                      <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_10">
                        <ui:AssignOperation.To>
                          <OutArgument x:TypeArguments="x:String">[EmailSubject]</OutArgument>
                        </ui:AssignOperation.To>
                        <ui:AssignOperation.Value>
                          <InArgument x:TypeArguments="x:String">["Follow-up Reminder - " &amp; in_InvoiceId &amp; " - Nerriza Transport Services"]</InArgument>
                        </ui:AssignOperation.Value>
                      </ui:AssignOperation>
                      <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_11">
                        <ui:AssignOperation.To>
                          <OutArgument x:TypeArguments="x:String">[EmailBody]</OutArgument>
                        </ui:AssignOperation.To>
                        <ui:AssignOperation.Value>
                          <InArgument x:TypeArguments="x:String">["Dear " &amp; ContactName &amp; "," &amp; vbCrLf &amp; vbCrLf &amp; "This is a follow-up reminder about the invoice below for " &amp; ClientName &amp; ", which still has an unpaid balance. We previously sent you this invoice." &amp; vbCrLf &amp; vbCrLf &amp; BodyDetails &amp; BodyClosing]</InArgument>
                        </ui:AssignOperation.Value>
                      </ui:AssignOperation>
                    </scg:List>
                  </ui:MultipleAssign.AssignOperations>
                </ui:MultipleAssign>
              </Sequence>
            </Switch.Default>
            <Sequence x:Key="Billing statement" DisplayName="Billing statement" sap2010:WorkflowViewState.IdRef="Sequence_6">
              <ui:MultipleAssign DisplayName="Build Billing Statement" sap2010:WorkflowViewState.IdRef="MultipleAssign_3">
                <ui:MultipleAssign.AssignOperations>
                  <scg:List x:TypeArguments="ui:AssignOperation" Capacity="4">
                    <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_6">
                      <ui:AssignOperation.To>
                        <OutArgument x:TypeArguments="x:String">[EmailSubject]</OutArgument>
                      </ui:AssignOperation.To>
                      <ui:AssignOperation.Value>
                        <InArgument x:TypeArguments="x:String">["Billing Statement - " &amp; in_InvoiceId &amp; " - Nerriza Transport Services"]</InArgument>
                      </ui:AssignOperation.Value>
                    </ui:AssignOperation>
                    <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_7">
                      <ui:AssignOperation.To>
                        <OutArgument x:TypeArguments="x:String">[EmailBody]</OutArgument>
                      </ui:AssignOperation.To>
                      <ui:AssignOperation.Value>
                        <InArgument x:TypeArguments="x:String">["Dear " &amp; ContactName &amp; "," &amp; vbCrLf &amp; vbCrLf &amp; "Please find below the billing statement for " &amp; ClientName &amp; "." &amp; vbCrLf &amp; vbCrLf &amp; BodyDetails &amp; BodyClosing]</InArgument>
                      </ui:AssignOperation.Value>
                    </ui:AssignOperation>
                  </scg:List>
                </ui:MultipleAssign.AssignOperations>
              </ui:MultipleAssign>
            </Sequence>
            <Sequence x:Key="Overdue reminder" DisplayName="Overdue reminder" sap2010:WorkflowViewState.IdRef="Sequence_7">
              <ui:MultipleAssign DisplayName="Build Overdue Reminder" sap2010:WorkflowViewState.IdRef="MultipleAssign_4">
                <ui:MultipleAssign.AssignOperations>
                  <scg:List x:TypeArguments="ui:AssignOperation" Capacity="4">
                    <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_8">
                      <ui:AssignOperation.To>
                        <OutArgument x:TypeArguments="x:String">[EmailSubject]</OutArgument>
                      </ui:AssignOperation.To>
                      <ui:AssignOperation.Value>
                        <InArgument x:TypeArguments="x:String">["OVERDUE - Payment Reminder for " &amp; in_InvoiceId &amp; " - Nerriza Transport Services"]</InArgument>
                      </ui:AssignOperation.Value>
                    </ui:AssignOperation>
                    <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_9">
                      <ui:AssignOperation.To>
                        <OutArgument x:TypeArguments="x:String">[EmailBody]</OutArgument>
                      </ui:AssignOperation.To>
                      <ui:AssignOperation.Value>
                        <InArgument x:TypeArguments="x:String">["Dear " &amp; ContactName &amp; "," &amp; vbCrLf &amp; vbCrLf &amp; "Our records show that the invoice below for " &amp; ClientName &amp; " is " &amp; DaysOverdue.ToString &amp; " day(s) past its due date. Please settle the remaining balance as soon as possible." &amp; vbCrLf &amp; vbCrLf &amp; BodyDetails &amp; BodyClosing]</InArgument>
                      </ui:AssignOperation.Value>
                    </ui:AssignOperation>
                  </scg:List>
                </ui:MultipleAssign.AssignOperations>
              </ui:MultipleAssign>
            </Sequence>
          </Switch>
          <TryCatch sap2010:Annotation.AnnotationText="If Gmail refuses the login or the connection fails, the Catch records the error and out_EmailSent stays False, so the invoice is not marked as emailed." DisplayName="Try Send Email" sap2010:WorkflowViewState.IdRef="TryCatch_1">
            <TryCatch.Try>
              <Sequence DisplayName="Try" sap2010:WorkflowViewState.IdRef="Sequence_9">
                <ui:SendMail Bcc="{x:Null}" Cc="{x:Null}" ContinueOnError="{x:Null}" From="{x:Null}" MailMessage="{x:Null}" Name="{x:Null}" ReplyTo="{x:Null}" ResourceAttachmentList="{x:Null}" ResourceAttachments="{x:Null}" Result="{x:Null}" SecurePassword="{x:Null}" TimeoutMS="{x:Null}" UseOAuth="{x:Null}" UseRichTextEditor="{x:Null}" Action="Forward" sap2010:Annotation.AnnotationText="Send SMTP Mail Message. Server smtp.gmail.com, port 465 (SSL). Email and Password are the sender Gmail and its App Password typed at the start of the run." AttachmentInputMode="None" Body="[EmailBody]" ConnectionMode="LegacyConfiguration" CreatedAfterSolutionSupport="True" DisplayName="Send Client Email (Gmail SMTP)" Email="[in_SenderEmail]" EnableSSL="True" sap2010:WorkflowViewState.IdRef="SendMail_1" IgnoreCRL="False" IsBodyHtml="False" Password="[in_AppPassword]" Port="[465]" SecureConnection="SslOnConnect" Server="smtp.gmail.com" Subject="[EmailSubject]" To="[ToEmail]" UseISConnection="False">
                  <ui:SendMail.AttachmentsBackup>
                    <usau:BackupSlot x:TypeArguments="umame:AttachmentInputMode" StoredValue="{x:Null}">
                      <usau:BackupSlot.BackupValues>
                        <scg:Dictionary x:TypeArguments="umame:AttachmentInputMode, scg:List(x:Object)" />
                      </usau:BackupSlot.BackupValues>
                    </usau:BackupSlot>
                  </ui:SendMail.AttachmentsBackup>
                  <ui:SendMail.ConnectionDetailsBackupSlot>
                    <usau:BackupSlot x:TypeArguments="umae:ConnectionDetails" StoredValue="{x:Null}">
                      <usau:BackupSlot.BackupValues>
                        <scg:Dictionary x:TypeArguments="umae:ConnectionDetails, scg:List(x:Object)" />
                      </usau:BackupSlot.BackupValues>
                    </usau:BackupSlot>
                  </ui:SendMail.ConnectionDetailsBackupSlot>
                  <ui:SendMail.Files>
                    <scg:List x:TypeArguments="InArgument(x:String)" Capacity="0" />
                  </ui:SendMail.Files>
                </ui:SendMail>
                <WriteLine sap2010:Annotation.AnnotationText="Prints a line to the Output panel for each email sent." DisplayName="Write Email Sent" sap2010:WorkflowViewState.IdRef="WriteLine_2" Text="[&quot;Email sent (&quot; &amp; in_EmailType &amp; &quot;) for &quot; &amp; in_InvoiceId &amp; &quot; to &quot; &amp; ToEmail]" />
                <Assign DisplayName="Mark Email Sent" sap2010:WorkflowViewState.IdRef="Assign_4">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:Boolean">[out_EmailSent]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:Boolean">[True]</InArgument>
                  </Assign.Value>
                </Assign>
              </Sequence>
            </TryCatch.Try>
            <TryCatch.Catches>
              <Catch x:TypeArguments="s:Exception" sap2010:WorkflowViewState.IdRef="Catch`1_1">
                <ActivityAction x:TypeArguments="s:Exception">
                  <ActivityAction.Argument>
                    <DelegateInArgument x:TypeArguments="s:Exception" Name="exception" />
                  </ActivityAction.Argument>
                  <Sequence DisplayName="Catch" sap2010:WorkflowViewState.IdRef="Sequence_10">
                    <WriteLine sap2010:Annotation.AnnotationText="Shows why the email failed (for example a wrong App Password)." DisplayName="Write Email Error" sap2010:WorkflowViewState.IdRef="WriteLine_3" Text="[&quot;Email FAILED for &quot; &amp; in_InvoiceId &amp; &quot;: &quot; &amp; exception.Message]" />
                  </Sequence>
                </ActivityAction>
              </Catch>
            </TryCatch.Catches>
          </TryCatch>
        </Sequence>
      </If.Else>
    </If>
  </Sequence>
</Activity>