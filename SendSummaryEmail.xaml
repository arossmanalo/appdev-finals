    <ui:MultipleAssign sap2010:Annotation.AnnotationText="Builds the email text from the counts and totals of the run. vbCrLf starts a new line. ToString(&quot;N2&quot;) formats money with commas and 2 decimals." DisplayName="Build Summary Subject and Body" sap:VirtualizedContainerService.HintSize="478,180" sap2010:WorkflowViewState.IdRef="MultipleAssign_1">
      <ui:MultipleAssign.AssignOperations>
        <scg:List x:TypeArguments="ui:AssignOperation" Capacity="4">
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_1">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:String">[SummarySubject]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:String">["Client Billing and Collections Summary - as of " &amp; in_AsOfDate.ToString("MMMM dd, yyyy")]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_2">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:String">[SummaryBody]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:String" xml:space="preserve">["Good day," &amp; vbCrLf &amp; vbCrLf &amp; "Here is the summary of today's billing and collections run for Nerriza Transport Services (as of " &amp; in_AsOfDate.ToString("MMMM dd, yyyy") &amp; ")." &amp; vbCrLf &amp; vbCrLf &amp; "INVOICES" &amp; vbCrLf &amp; "Processed: " &amp; in_ProcessedCount.ToString &amp; vbCrLf &amp; "  Paid: " &amp; in_PaidCount.ToString &amp; vbCrLf &amp; "  Partially Paid: " &amp; in_PartialCount.ToString &amp; vbCrLf &amp; "  Unpaid: " &amp; in_UnpaidCount.ToString &amp; vbCrLf &amp; "  Overdue: " &amp; in_OverdueCount.ToString &amp; vbCrLf &amp; "Invalid (skipped, needs review): " &amp; in_InvalidCount.ToString &amp; vbCrLf &amp; "Skipped (already emailed): " &amp; in_SkippedCount.ToString &amp; vbCrLf &amp; vbCrLf &amp; "AMOUNTS (PHP)" &amp; vbCrLf &amp; "Total billed: " &amp; in_TotalBilled.ToString("N2") &amp; vbCrLf &amp; "Total paid: " &amp; in_TotalPaid.ToString("N2") &amp; vbCrLf &amp; "Total balance: " &amp; in_TotalBalance.ToString("N2") &amp; vbCrLf &amp; vbCrLf &amp; "CLIENT EMAILS" &amp; vbCrLf &amp; "Sent: " &amp; in_EmailsSentCount.ToString &amp; vbCrLf &amp; "Failed: " &amp; in_EmailsFailedCount.ToString &amp; vbCrLf &amp; vbCrLf &amp; "The processed workbook is attached." &amp; vbCrLf &amp; vbCrLf &amp; "Regards," &amp; vbCrLf &amp; "Billing Automation Robot" &amp; vbCrLf &amp; "Finance and Accounting, Nerriza Transport Services"]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
        </scg:List>
      </ui:MultipleAssign.AssignOperations>
    </ui:MultipleAssign>
