  <Sequence sap2010:Annotation.AnnotationText="Emails the Finance Head/CFO a summary of the run (counts and totals) with the processed workbook attached, then shows the Email Sent message." DisplayName="Send Summary Email" sap:VirtualizedContainerService.HintSize="1285,1700" sap2010:WorkflowViewState.IdRef="Sequence_1">
